# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------- server/ (Express) ----------

# Senha única do painel /admin (super-admin, dá acesso aos 4 restaurantes).
# Em produção, defina isso direto no painel do Render — nunca comite a senha real.
ADMIN_PASSWORD="troque-esta-senha"

# Fase 2 — Supabase (opcional). Se as duas variáveis abaixo NÃO estiverem
# definidas, o servidor usa automaticamente o backend em arquivos JSON
# (server/data/) — nada quebra em dev local sem Supabase configurado.
#
# SUPABASE_URL: URL do projeto (Dashboard → Project Settings → API).
SUPABASE_URL="https://ojztmcnghgsrvstmasnc.supabase.co"
#
# SUPABASE_SERVICE_ROLE_KEY: a chave "service_role" (Dashboard → Project
# Settings → API → Project API keys). NUNCA a chave "anon/public".
# Esta chave ignora Row Level Security por completo — só pode existir aqui,
# no ambiente do servidor (Render → Environment). JAMAIS no frontend/bundle,
# JAMAIS commitada no git (ver server/lib/supabaseClient.js).
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key-aqui"

# Fase 4 — Cloudinary (opcional, mas recomendado em produção). Se as 3
# variáveis abaixo NÃO estiverem definidas, o servidor usa automaticamente
# o armazenamento local de sempre (server/data/uploads/) — nada quebra em
# dev local sem conta Cloudinary. Sem elas em produção (Render), as fotos
# enviadas (logo, banner, splash, pratos, entregadores) somem no próximo
# redeploy, porque o disco do Render é efêmero.
#
# As 3 vêm do Dashboard do Cloudinary (cloudinary.com → Dashboard):
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
# CLOUDINARY_API_SECRET: nunca comitar o valor real, nunca expor no
# frontend — usada só pelo backend (server/lib/cloudinary.js).
CLOUDINARY_API_SECRET="cole-o-api-secret-aqui"

# Fase 4 — Notificações push (opcional). Sem essas 3 variáveis, o botão de
# sino no cardápio do cliente simplesmente não ativa nada (isPushConfigured()
# = false) — nada quebra, só o envio real fica desligado até configurar.
#
# Gere o par de chaves uma única vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# (depois de rodar `npm install`, já que a lib web-push foi adicionada nesta
# fase) e cole os valores abaixo (Render → Environment em produção):
VAPID_PUBLIC_KEY="cole-a-chave-publica-aqui"
VAPID_PRIVATE_KEY="cole-a-chave-privada-aqui"
# VAPID_SUBJECT: um "mailto:" ou URL do site — exigido pelo protocolo Web
# Push pra identificar quem está enviando, caso o navegador precise contatar.
VAPID_SUBJECT="mailto:contato@seurestaurante.com"
